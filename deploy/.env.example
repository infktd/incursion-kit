# Settings for deploy/compose.prod.yaml. Copy to deploy/.env (which git ignores) and fill in.
# Never commit real values. See docs/deploy.md.

# The site's public host name. Caddy gets an HTTPS certificate for it; the EVE SSO callback is
# https://$SITE_HOST/auth/cb (register exactly that with your ESI application).
SITE_HOST=waitlist.example.org
# Contact address for the certificate authority (expiry and problem notices).
ACME_EMAIL=

# The backend image.
# Pin a release, e.g. :0.1, in production.
WAITLIST_IMAGE=ghcr.io/infktd/incursion-kit/waitlist:latest

# MySQL passwords. Generate with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# Session encryption key: 64 hex characters. Generate with: openssl rand -hex 32
# When migrating from an existing waitlist, reuse its app.token_secret to keep users logged in.
TOKEN_SECRET=

# Your application at https://developers.eveonline.com (callback https://$SITE_HOST/auth/cb).
ESI_CLIENT_ID=
ESI_CLIENT_SECRET=

# Frontend: `static` serves the files in FRONTEND_DIR, `upstream` proxies to FRONTEND_UPSTREAM.
FRONTEND_MODE=static
FRONTEND_DIR=./frontend
FRONTEND_UPSTREAM=

# Log filter (e.g. `info`, `info,wl_api=debug`).
RUST_LOG=info

# Backups (deploy/backup.sh): where to write them and how many of each to keep.
BACKUP_DIR=./backups
BACKUP_KEEP=14
